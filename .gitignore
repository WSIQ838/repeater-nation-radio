node_modules/
dist/
.env
.env.local

# Tauri build output and generated schemas
src-tauri/target/
src-tauri/gen/

# Platform icons are generated in CI from icons/icon.svg. icon.png and icon.ico stay
# committed so a fresh checkout runs `tauri dev` on every platform.
src-tauri/icons/*
!src-tauri/icons/icon.svg
!src-tauri/icons/icon.ico
!src-tauri/icons/icon.png

# Lockfiles are regenerated by each build (CI runs npm install without one)
src-tauri/Cargo.lock
package-lock.json
