{
 "name": "ProfilePost",
 "type": "object",
 "properties": {
  "content": {
   "type": "string",
   "description": "The post's text content."
  },
  "image_urls": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "default": [],
   "description": "Legacy uploaded photo URLs attached to the post. Superseded by attachments; kept for posts created before attachments existed."
  },
  "attachments": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "description": "Public URL of the uploaded file."
     },
     "type": {
      "type": "string",
      "enum": [
       "image",
       "video",
       "file"
      ],
      "description": "Kind of attachment, derived from the file MIME type."
     },
     "name": {
      "type": "string",
      "description": "Original file name."
     },
     "mime": {
      "type": "string",
      "description": "File MIME type."
     }
    }
   },
   "default": [],
   "description": "Photos (including GIFs), videos, and file attachments on the post."
  },
  "mentions": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "default": [],
   "description": "Callsigns of members tagged in this post, via the tag picker or an @callsign in the content."
  },
  "author_name": {
   "type": "string"
  },
  "author_avatar_url": {
   "type": "string"
  },
  "liked_by": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "default": [],
   "description": "User ids who liked this post."
  },
  "comments_count": {
   "type": "number",
   "default": 0,
   "description": "Denormalized count of ProfilePostComment records, kept in sync by adjust-profile-post-comments."
  }
 },
 "rls": {
  "create": {
   "created_by_id": "{{user.id}}"
  },
  "read": null,
  "update": {
   "$or": [
    {
     "created_by_id": "{{user.id}}"
    },
    {
     "user_condition": {
      "role": "admin"
     }
    },
    {
     "user_condition": {
      "role": "super_admin"
     }
    }
   ]
  },
  "delete": {
   "$or": [
    {
     "created_by_id": "{{user.id}}"
    },
    {
     "user_condition": {
      "role": "admin"
     }
    },
    {
     "user_condition": {
      "role": "super_admin"
     }
    }
   ]
  }
 }
}