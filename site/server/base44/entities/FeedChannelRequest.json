   "maxLength": 300
  },
  "status": {
   "type": "string",
   "enum": [
    "pending",
    "approved",
    "rejected"
   ],
   "default": "pending"
  },
  "channel_id": {
   "description": "The channel created when approved.",
   "type": "string"
  },
  "decided_by": {
   "type": "string"
  },
  "decided_at": {
   "format": "date-time",
   "type": "string"
  },
  "reason": {
   "description": "Why it was rejected.",
   "type": "string"
  }
 },
 "required": [
  "requester_user_id",
  "name"
 ],
 "type": "object",
 "rls": {
  "read": false,
