{
 "name": "ProfilePostComment",
 "type": "object",
 "properties": {
  "post_id": {
   "type": "string",
   "description": "The ProfilePost this comment belongs to."
  },
  "body": {
   "type": "string"
  },
  "author_name": {
   "type": "string"
  },
  "author_avatar_url": {
   "type": "string"
  },
  "liked_by": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "default": [],
   "description": "User ids who liked this comment."
  }
 },
 "required": [
  "post_id",
  "body"
 ],
 "rls": {
  "create": {
   "created_by_id": "{{user.id}}"
  },
  "read": null,
  "update": {
   "$or": [
    {
     "created_by_id": "{{user.id}}"
    },
    {
     "user_condition": {
      "role": "admin"
     }
    },
    {
     "user_condition": {
      "role": "super_admin"
     }
    },
    {
     "user_condition": {
      "role": "moderator"
     }
    }
   ]
  },
  "delete": {
   "$or": [
    {
     "created_by_id": "{{user.id}}"
    },
    {
     "user_condition": {
      "role": "admin"
     }
    },
    {
     "user_condition": {
      "role": "super_admin"
     }
    },
    {
     "user_condition": {
      "role": "moderator"
     }
    }
   ]
  }
 }
}