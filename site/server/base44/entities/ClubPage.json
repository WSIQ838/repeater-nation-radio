{
 "name": "ClubPage",
 "type": "object",
 "properties": {
  "club_id": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "body": {
   "type": "string",
   "description": "Markdown body of the club page."
  },
  "page_type": {
   "type": "string",
   "enum": [
    "Info",
    "Rules",
    "Announcement",
    "FAQ",
    "Resources",
    "Discussion"
   ],
   "default": "Info",
   "description": "Category of this club page."
  },
  "author_callsign": {
   "type": "string"
  },
  "author_name": {
   "type": "string"
  },
  "image_urls": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "default": [],
   "description": "Uploaded photo URLs attached to the club page."
  },
  "club_owner_id": {
   "type": "string",
   "description": "User id of the club owner (Club.created_by_id). Stamped at creation so the owner can manage this page via RLS."
  }
 },
 "required": [
  "club_id",
  "title",
  "body"
 ],
 "rls": {
  "create": {
   "user_condition": {
    "role": "super_admin"
   }
  },
  "read": null,
  "update": {
   "$or": [
    {
     "user_condition": {
      "role": "super_admin"
     }
    },
    {
     "user_condition": {
      "role": "admin"
     }
    }
   ]
  },
  "delete": {
   "$or": [
    {
     "user_condition": {
      "role": "super_admin"
     }
    },
    {
     "user_condition": {
      "role": "admin"
     }
    }
   ]
  }
 }
}