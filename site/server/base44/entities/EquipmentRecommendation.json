{
 "name": "EquipmentRecommendation",
 "type": "object",
 "properties": {
  "name": {
   "type": "string"
  },
  "manufacturer": {
   "type": "string"
  },
  "model": {
   "type": "string"
  },
  "category": {
   "type": "string"
  },
  "service_type": {
   "type": "string",
   "enum": [
    "GMRS",
    "HAM",
    "Both"
   ],
   "default": "Both"
  },
  "price_label": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "image_url": {
   "type": "string"
  },
  "affiliate_url": {
   "type": "string"
  },
  "store": {
   "type": "string",
   "default": "Amazon"
  },
  "featured": {
   "type": "boolean",
   "default": false
  },
  "sort_order": {
   "type": "number",
   "default": 0
  },
  "active": {
   "type": "boolean",
   "default": true
  }
 },
 "required": [
  "name",
  "category",
  "affiliate_url"
 ],
 "rls": {
  "read": null,
  "create": {
   "user_condition": {
    "role": "admin"
   }
  },
  "update": {
   "user_condition": {
    "role": "admin"
   }
  },
  "delete": {
   "user_condition": {
    "role": "admin"
   }
  }
 }
}