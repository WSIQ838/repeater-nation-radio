# Copy to .env and fill in. Never commit .env.

# ---- required ----
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# openssl rand -hex 32   (or any 40+ random characters)
JWT_SECRET=
# The address people type to reach the site, no trailing slash. Used in e-mails, social-login
# callbacks and Stripe/Discord links.
PUBLIC_URL=http://localhost:8080
# Only for the optional HTTPS profile
SITE_DOMAIN=localhost
HTTP_PORT=8080

# ---- e-mail (sign-up codes, password resets, notifications) ----
# Without SMTP, e-mails are only printed in the server log, so nobody can verify an account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Repeater Nation <no-reply@yourdomain.com>
SMTP_SECURE=false

# ---- social sign-in (leave blank to hide a provider). Redirect URL for each:
#      {PUBLIC_URL}/api/auth/oauth/<google|microsoft|facebook|apple>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- features (same names your Base44 app used as secrets) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RADIO_TOKEN_SECRET=
ACTOR_TOKEN_SECRET=
API_KEY_PEPPER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTFUL_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
CHANGELOG_DISCORD_WEBHOOK_URL=
SOCIAL_CONNECT_STATE_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
APRS_FI_API_KEY=
WEATHER_API_KEY=
REPEATERBOOK_API_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
SOTA_SYNC_APPROVED=
X_RN_SDR_SECRET=
RXT_TX_IMPORT_SECRET=
