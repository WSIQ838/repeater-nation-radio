{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repeater Nation Radio",
  "version": "0.1.4",
  "identifier": "com.repeaternation.radio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "https://repeaternation.com/?radio=desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Repeater Nation Radio",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "url": "https://repeaternation.com/?radio=desktop"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "repeaternation"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
